{
    "name": "@rocklobster42195/streamdeck-kit",
    "version": "0.1.0-alpha.23",
    "description": "(Alpha) Building blocks for Elgato Stream Deck plugins: key and touch-strip rendering, animation, Panorama effects across dials, and a framework-free property inspector kit.",
    "license": "MIT",
    "author": "Boris Kemper",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rocklobster42195/streamdeck-kit.git",
        "directory": "packages/kit"
    },
    "homepage": "https://github.com/rocklobster42195/streamdeck-kit#readme",
    "bugs": {
        "url": "https://github.com/rocklobster42195/streamdeck-kit/issues"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./pi": {
            "types": "./dist/pi/index.d.ts",
            "import": "./dist/pi/index.js"
        },
        "./bridge": {
            "types": "./dist/pi-bridge.d.ts",
            "import": "./dist/pi-bridge.js"
        },
        "./bus": {
            "types": "./dist/bus/index.d.ts",
            "import": "./dist/bus/index.js"
        },
        "./mdi": {
            "types": "./dist/mdi/index.d.ts",
            "import": "./dist/mdi/index.js"
        },
        "./keys": {
            "types": "./dist/keys/index.d.ts",
            "import": "./dist/keys/index.js"
        },
        "./styles/*": "./styles/*",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "styles",
        "README.md"
    ],
    "keywords": [
        "streamdeck",
        "stream deck",
        "elgato",
        "plugin",
        "property inspector",
        "stream deck plus"
    ],
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "npm run clean && tsc -p tsconfig.json",
        "prepack": "npm run build"
    },
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@mdi/js": "^7.4.47"
    },
    "peerDependencies": {
        "@elgato/streamdeck": "^2.0.0"
    }
}
